{
  "name": "docupulse-ai",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "npx concurrently -n web,api -c blue,green \"npm run dev -w apps/web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "node scripts/run-api.mjs",
    "build:web": "npm run build -w apps/web",
    "gen": "npm run gen -w packages/contracts",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web && npm run check -w packages/contracts",
    "worker:tick": "node scripts/worker-tick.mjs"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "supabase": "2.122.0"
  }
}
