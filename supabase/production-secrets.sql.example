-- Run ONCE in the production Supabase SQL editor (and once per preview project/branch).
-- Stores the API URL and worker secret in Vault so pg_cron can call the Vercel worker endpoints.
-- Copy this file, fill in the values, run it, and do NOT commit the filled-in copy.

select vault.create_secret('https://<api-project>.vercel.app', 'api_url');
select vault.create_secret('<same value as WORKER_SECRET in the api Vercel project>', 'worker_secret');

-- Verify (shows names only):
select name, created_at from vault.secrets where name in ('api_url', 'worker_secret');
-- Cron jobs created by migration 20261024000002_cron.sql:
select jobname, schedule, active from cron.job order by jobname;
