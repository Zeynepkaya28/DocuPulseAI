# Copy to .env (api) and apps/web/.env.local (web). Never commit real values.
# Local values come from `npx supabase status` after `npx supabase start`.

# ── Browser-safe (web) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Server-only (api). NEVER prefix these with NEXT_PUBLIC_ ──
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Production: Supabase pooler URL (transaction mode, port 6543)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=docupulse-dev

# openai (production) | ollama (local only) | fake (tests / no key)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Shared secret for Supabase Cron → /internal/workers/{queue}
WORKER_SECRET=change-me

# Optional rate limit store (Vercel Marketplace → Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

ALLOWED_ORIGINS=http://localhost:3000
